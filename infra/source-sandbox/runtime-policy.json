{
  "policy_version": "wfd-fetch-static-1.0",
  "network_mode": "isolated-egress-proxy",
  "dns_mode": "all-addresses-verified-before-connect",
  "allow_protocols": ["http", "https"],
  "allow_ports": [80, 443],
  "dynamic_rendering": false,
  "attachments": false,
  "reviewer_navigation": false,
  "credentials": [],
  "host_mounts": [],
  "docker_socket": false,
  "host_network": false,
  "privileged": false,
  "read_only_rootfs": true,
  "no_new_privileges": true,
  "drop_capabilities": ["ALL"],
  "max_task_seconds": 30,
  "max_response_bytes": 10485760,
  "max_task_network_bytes": 31457280,
  "max_network_requests": 100,
  "max_redirects": 3,
  "max_retries": 1,
  "max_output_characters": 100000,
  "link_checker_response_bytes": 2097152
}
