{
  "name": "open-sxgo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx scripts/demo.ts",
    "build": "vite build --config apps/web/vite.config.ts && vite build --config apps/intake/vite.config.ts && vite build --config apps/admin/vite.config.ts && tsx scripts/stage-site.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "api": "tsx apps/api/src/node.ts",
    "verify": "tsx packages/verifier/src/cli.ts",
    "mirror": "tsx packages/mirror-sync/src/cli.ts",
    "auth:invite": "tsx scripts/invite.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "worker:types": "wrangler types --config apps/api/wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --config apps/api/wrangler.jsonc",
    "recovery": "tsx scripts/recovery.ts",
    "mirror:serve": "tsx scripts/serve-mirror.ts",
    "demo:publish": "tsx scripts/publish-approved-demo.ts",
    "setup": "pnpm worker:types && pnpm demo",
    "preview": "tsx scripts/preview.ts",
    "links:check": "tsx scripts/check-links.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.json *.yaml docs .github",
    "format:check": "prettier --check apps packages scripts tests *.ts *.json *.yaml docs .github",
    "check:offline": "tsx scripts/check-offline.ts",
    "sign": "tsx scripts/sign.ts",
    "release:prepare": "tsx scripts/prepare-release.ts",
    "test:differential": "tsx scripts/differential.ts",
    "key:new": "tsx scripts/generate-key.ts",
    "governance:demo": "tsx scripts/governance-demo.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "ipfs:publish": "tsx scripts/ipfs-publish.ts",
    "mirror:up": "sh scripts/mirror-up.sh",
    "api:postgres": "tsx apps/api/src/node-postgres.ts",
    "db:postgres:migrate": "tsx scripts/migrate-postgres.ts",
    "cloudflare:types": "tsx scripts/cloudflare-types.ts",
    "cloudflare:check": "wrangler deploy --dry-run --config apps/cloudflare/wrangler.jsonc",
    "cloudflare:deploy": "tsx scripts/deploy-cloudflare.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@better-auth/passkey": "1.7.4",
    "@hono/node-server": "^2.1.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.1",
    "@tufjs/canonical-json": "^2.0.0",
    "better-auth": "^1.7.4",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tuf-js": "^6.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.1",
    "miniflare": "4.20260730.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  },
  "packageManager": "pnpm@11.9.0"
}
