          "public_identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "aliases": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "industry": {
