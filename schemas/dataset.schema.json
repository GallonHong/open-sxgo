          "company_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,100}$"
          },
          "legal_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "jurisdiction": {
