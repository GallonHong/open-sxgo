{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,100}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "categories": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "brand_id",
    "name",
    "categories"
  ],
  "additionalProperties": false
}