{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,100}$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,100}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "publish",
        "correct",
        "suppress",
        "withdraw"
      ]
    },
    "rule_version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,100}$"
    },
    "reviewer_key_ids": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "publication_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "decision_id",
    "record_id",
    "action",
    "rule_version",
    "reviewer_key_ids",
    "publication_date"
  ],
  "additionalProperties": false
}