{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,100}$"
    },
    "legal_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "jurisdiction": {
      "type": "string",
      "const": "CN"
    },
    "public_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "aliases": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "industry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "entity_status": {
      "type": "string",
      "enum": [
        "checked",
        "pending"
      ]
    },
    "scopes": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,100}$"
          },
          "company_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,100}$"
          },
          "city_code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "site_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "job_group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "employment_type": {
            "type": "string",
            "enum": [
              "full_time_employee",
              "other",
              "unknown"
            ]
          },
          "work_time_regime": {
            "type": "string",
            "enum": [
              "standard",
              "special_regime_pending_review"
            ]
          },
          "listing_state": {
            "type": "string",
            "enum": [
              "active",
              "recheck_required",
              "suppressed",
              "expired",
              "withdrawn_from_directory"
            ]
          },
          "claims": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{2,100}$"
                },
                "scope_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{2,100}$"
                },
                "dimension": {
                  "type": "string",
                  "enum": [
                    "rest_schedule",
                    "written_contract_policy",
                    "working_hours_policy",
                    "overtime_payment_practice",
                    "salary_policy",
                    "social_insurance_policy",
                    "annual_leave_policy",
                    "extra_leave",
                    "safety_policy"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 300
                    },
                    {
                      "type": "object",
                      "properties": {
                        "usual_rest_days_per_week": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 7
                        },
                        "usual_rest_days": {
                          "maxItems": 7,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "monday",
                              "tuesday",
                              "wednesday",
                              "thursday",
                              "friday",
                              "saturday",
                              "sunday"
                            ]
                          }
                        },
                        "holiday_adjustments_excluded": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "usual_rest_days_per_week",
                        "usual_rest_days",
                        "holiday_adjustments_excluded"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence_status": {
                  "type": "string",
                  "enum": [
                    "unknown",
                    "self_declared",
                    "source_checked",
                    "practice_corroborated",
                    "needs_recheck",
                    "expired"
                  ]
                },
                "source_ids": {
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{2,100}$"
                  }
                },
                "checked_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "valid_from": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "valid_until": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rule_version": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{2,100}$"
                }
              },
              "required": [
                "claim_id",
                "scope_id",
                "dimension",
                "value",
                "evidence_status",
                "source_ids",
                "checked_on",
                "valid_from",
                "valid_until",
                "rule_version"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "record_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "scope_id",
          "company_id",
          "city_code",
          "city",
          "site_label",
          "job_group",
          "employment_type",
          "work_time_regime",
          "listing_state",
          "claims",
          "limitations",
          "record_revision"
        ],
        "additionalProperties": false
      }
    },
    "official_website_link_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,100}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "brand_ids": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{2,100}$"
      }
    }
  },
  "required": [
    "company_id",
    "legal_name",
    "jurisdiction",
    "public_identifier",
    "aliases",
    "industry",
    "entity_status",
    "scopes",
    "official_website_link_id",
    "brand_ids"
  ],
  "additionalProperties": false
}