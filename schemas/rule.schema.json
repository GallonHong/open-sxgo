{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rule_version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,100}$"
    },
    "jurisdiction": {
      "type": "string",
      "const": "CN"
    },
    "effective_from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "effective_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewed_on": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048,
        "format": "uri"
      }
    },
    "policy_ttl_days": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 180
    },
    "practice_ttl_days": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 90
    },
    "warning_days": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "metadata_ttl_hours": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 48
    },
    "demo": {
      "type": "boolean"
    }
  },
  "required": [
    "rule_version",
    "jurisdiction",
    "effective_from",
    "effective_to",
    "reviewed_on",
    "sources",
    "policy_ttl_days",
    "practice_ttl_days",
    "warning_days",
    "metadata_ttl_hours",
    "demo"
  ],
  "additionalProperties": false
}