# This file contains no production credentials.
MIRROR_SOURCE=http://host.docker.internal:5173/public/
WFD_ADMIN_ORIGIN=http://localhost:5175
WFD_INTAKE_ORIGIN=http://127.0.0.1:5174
# Production identity and signing material must be provisioned separately.

# Optional PostgreSQL runtime (never paste real credentials into this example).
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
# BETTER_AUTH_SECRET=<keep existing secret when migrating encrypted MFA records>
# WFD_INTAKE_ENABLED=false
# Cloudflare deployment identifiers, not secrets:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_HYPERDRIVE_ID=
# WFD_PUBLIC_ORIGIN=https://your-staging-domain

# Install PILOT_COOKIE_SECRET and PILOT_INVITE_HASHES via Wrangler secrets only.
